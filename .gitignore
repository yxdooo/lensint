# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
**/*.pyc
**/__pycache__/**

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Temporary debug scripts and local scratch files
debug_*.py
debug_*.png
test_output/
tmp/
temp/
*.log

# Generated output files (except committed samples & static assets)
*.bin
*.pdf
*.yar
*.dmp
*.raw
*.vmem

# Whitelist intentional sample images and static assets
!sample_images/**
!lensint/web/**

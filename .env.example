# ==============================================================================
# LENSINT Forensics Framework — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as needed:
#   cp .env.example .env

# --- Threat Intelligence API Keys (Optional) ---
# VirusTotal API Key for automated file hash queries
LENSINT_VIRUSTOTAL_API_KEY=

# Shodan API Key for automated IP address infrastructure lookups
LENSINT_SHODAN_API_KEY=

# AbuseIPDB API Key for IP reputation checking
LENSINT_ABUSEIPDB_API_KEY=

# --- Server & API Configuration ---
LENSINT_HOST=0.0.0.0
LENSINT_PORT=8000
LENSINT_MAX_UPLOAD_MB=50

# --- Forensic Caching ---
LENSINT_CACHE_ENABLED=true
LENSINT_CACHE_TTL_HOURS=72
# LENSINT_CACHE_DIR=/path/to/custom/cache

# --- Chain of Custody & Audit Logging ---
LENSINT_AUDIT_ENABLED=true
# LENSINT_AUDIT_DIR=/path/to/custom/audit_logs
LENSINT_LOG_LEVEL=INFO

# --- OSINT & Geocoding ---
LENSINT_USER_AGENT=lensint-forensics-framework/2.5
LENSINT_GEOLOOKUP_TIMEOUT=3

# ==============================================================================
# LENSINT Forensics Framework — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as needed:
#   cp .env.example .env

# --- Threat Intelligence API Keys (Optional) ---
# VirusTotal API Key for automated file hash queries
LENSINT_VIRUSTOTAL_API_KEY=

# Shodan API Key for automated IP address infrastructure lookups
LENSINT_SHODAN_API_KEY=

# AbuseIPDB API Key for IP reputation checking
LENSINT_ABUSEIPDB_API_KEY=

# --- Server & API Configuration ---
LENSINT_HOST=0.0.0.0
LENSINT_PORT=8000
LENSINT_MAX_UPLOAD_MB=50

# --- Forensic Caching ---
LENSINT_CACHE_ENABLED=true
LENSINT_CACHE_TTL_HOURS=72
# LENSINT_CACHE_DIR=/path/to/custom/cache

# --- Chain of Custody & Audit Logging ---
LENSINT_AUDIT_ENABLED=true
# LENSINT_AUDIT_DIR=/path/to/custom/audit_logs
LENSINT_LOG_LEVEL=INFO

# --- OSINT & Geocoding ---
LENSINT_USER_AGENT=lensint-forensics-framework/2.5
LENSINT_GEOLOOKUP_TIMEOUT=3

# --- REST API Security ---
# Set this to a strong random string to enable API key authentication.
# When set, all /api/* endpoints require: X-API-Key: <value>
# Leave empty for open (unauthenticated) local development mode.
LENSINT_API_KEY=

# CORS origins for the REST API (comma-separated, or * for any)
# LENSINT_CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# --- Rate Limiting (active only when LENSINT_API_KEY is set) ---
# Maximum number of requests per minute per client IP
LENSINT_RATE_LIMIT_PER_MIN=30
# Burst allowance (short spike tolerance above the per-minute rate)
LENSINT_RATE_LIMIT_BURST=10

# --- Neural ONNX Deepfake Pipeline ---
# Directory containing deepfake_detector.onnx and manifest.json
# Defaults to ~/.lensint/models/ when not set.
# LENSINT_ONNX_MODEL_DIR=/path/to/models

# --- Analysis Pipeline Tuning ---
# Per-module timeout in seconds (default: 120).
# Modules exceeding this limit are skipped with a warning.
LENSINT_MODULE_TIMEOUT=120
